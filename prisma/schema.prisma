generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum BookingType {
  VIRTUAL
  IN_PERSON
}

enum BookingStatus {
  PENDING
  PAYMENT_SUBMITTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  EXPIRED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  password String
  name     String?
  role     String  @default("ADMIN")

  // Xinteck Security Additions
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  lastActiveAt     DateTime?

  sessions          Session[]
  assignedInquiries Inquiry[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  mealPlanOrders MealPlanOrder[]

  @@index([email])
  @@index([role])
}

model Session {
  id                String   @id @default(cuid())
  token             String   @unique
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt         DateTime
  userAgent         String?
  ipAddress         String?
  twoFactorVerified Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model StaffInvitation {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("ADMIN")
  token     String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

// ... existing models updated with Xinteck patterns ...

model BlockedDate {
  id        String   @id @default(cuid())
  date      DateTime @unique
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model BlogPost {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String?       @db.Text
  content     String
  published   Boolean       @default(false)
  status      ContentStatus @default(DRAFT)
  views       Int           @default(0)
  version     Int           @default(0)
  publishedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id])

  image           String?
  metaTitle       String?
  metaDescription String?

  // AI workflow relation
  blogIdea BlogIdea?

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([createdAt])
}

model BlogCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  color       String?
  posts       BlogPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model BlogIdea {
  id              String    @id @default(cuid())
  title           String
  angle           String    @db.Text
  keywords        String[]
  score           Int       @default(0)
  reasoning       String?   @db.Text
  sources         String[]
  status          String    @default("NEW") // NEW, APPROVED, REJECTED, DRAFTED
  generatedPostId String?   @unique
  generatedPost   BlogPost? @relation(fields: [generatedPostId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([score])
  @@index([createdAt])
}

model SecretConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model Booking {
  id          String      @id @default(cuid())
  clientName  String
  clientEmail String
  clientPhone String?
  serviceId   String?
  service     Service?    @relation(fields: [serviceId], references: [id])
  serviceName String // Kept for backwards compat
  sessionType String      @default("virtual") // Kept for backwards compat
  type        BookingType @default(VIRTUAL)

  scheduledAt DateTime // Kept for backwards compat
  date        DateTime?
  time        String?
  duration    Int       @default(60)

  statusString  String        @default("CONFIRMED") @map("status") // Kept for backwards compat
  bookingStatus BookingStatus @default(PENDING) @map("booking_status")

  notes                  String?   @db.Text
  expectedAmount         Int?
  paymentDeadline        DateTime?
  mpesaTransactionCode   String?
  paymentSubmittedAt     DateTime?
  amountPaid             Int? // Snapshot of Revenue confirmed by Admin Admin Dashboard.
  googleEventId          String?   @unique
  encryptedMeetLink      String?
  clientTimezone         String    @default("Africa/Nairobi")
  referenceCode          String?   @unique
  reminder1hSent         Boolean   @default(false)
  reminder6hSent         Boolean   @default(false)
  adminReminder30mSent   Boolean   @default(false)
  adminReminder15mSent   Boolean   @default(false)
  paymentReviewNudgeSent Boolean   @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  payments       Payment[]
  mealPlanOrders MealPlanOrder[]

  @@index([date])
  @@index([statusString])
  @@index([bookingStatus])
  @@index([serviceId])
  @@index([clientEmail])
  @@index([scheduledAt])
}

model Service {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  shortDescription String
  fullDescription  String?
  features         String[]
  targetAudience   String?
  icon             String        @default("Activity")
  color            String        @default("text-brand-green")
  bgColor          String        @default("bg-brand-green/10")
  priceVirtual     Int?
  priceInPerson    Int?
  isVisible        Boolean       @default(true) // Kept for backwards compat
  status           ContentStatus @default(PUBLISHED)
  displayOrder     Int           @default(0)
  version          Int           @default(0)
  image            String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  bookings     Booking[]
  testimonials Testimonial[]
  mealPlans    MealPlan[]

  @@index([slug])
  @@index([status])
  @@index([displayOrder])
}

model Inquiry {
  id           String  @id @default(cuid())
  name         String
  email        String
  phone        String?
  message      String  @db.Text
  statusString String  @default("NEW") @map("status") // Kept for backwards compat
  isStarred    Boolean @default(false)
  isArchived   Boolean @default(false)
  isRead       Boolean @default(false)

  preferredDate DateTime?
  ipAddress     String?
  userAgent     String?

  // RBAC: Lead assignment
  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  // Relations
  notes   InquiryNote[]
  replies InquiryReply[]

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([email])
  @@index([isStarred])
  @@index([isArchived])
  @@index([isRead])
  @@index([assignedToId])
  @@index([createdAt])
}

model InquiryNote {
  id      String @id @default(cuid())
  content String @db.Text

  inquiryId String
  inquiry   Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  userId   String
  userName String // Denormalized for display without joins

  createdAt DateTime @default(now())

  @@index([inquiryId])
}

model InquiryReply {
  id      String @id @default(cuid())
  content String @db.Text

  inquiryId String
  inquiry   Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  sentBy String? // userId of admin who sent
  sentAt DateTime @default(now())

  @@index([inquiryId])
}

model Testimonial {
  id            String        @id @default(cuid())
  authorName    String
  rating        Int           @default(5)
  content       String        @db.Text
  statusString  String        @default("PENDING") @map("status") // Kept for backwards compat
  contentStatus ContentStatus @default(IN_REVIEW) @map("content_status")

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([statusString])
  @@index([contentStatus])
  @@index([serviceId])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  isActive       Boolean   @default(true)
  source         String?
  unsubscribedAt DateTime?
  deletedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([isActive])
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
}

enum CampaignTarget {
  ALL
  ACTIVE_ONLY
}

model NewsletterCampaign {
  id             String         @id @default(cuid())
  subject        String
  previewText    String?
  content        String         @db.Text
  status         CampaignStatus @default(DRAFT)
  targetAudience CampaignTarget @default(ACTIVE_ONLY)
  sentCount      Int            @default(0)

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([sentAt])
}

model AuditLog {
  id        String  @id @default(cuid())
  action    String
  entity    String
  entityId  String
  userId    String?
  metadata  Json?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([action])
  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id       String               @id @default(cuid())
  userId   String
  type     String
  title    String
  message  String               @db.Text
  priority NotificationPriority @default(NORMAL)
  link     String?
  isRead   Boolean              @default(false)
  metadata Json?

  readAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, isRead])
  @@index([expiresAt])
}

model MediaFolder {
  id       String        @id @default(cuid())
  name     String
  parentId String?
  parent   MediaFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children MediaFolder[] @relation("FolderHierarchy")
  files    MediaFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model MediaFile {
  id       String       @id @default(cuid())
  publicId String       @unique
  url      String
  filename String
  size     Int
  mimeType String
  folderId String?
  folder   MediaFolder? @relation(fields: [folderId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([folderId])
}

// Settings Models (Keeping existing structure for backwards compatibility)
model CloudinaryConfig {
  id                 String       @id @default(cuid())
  settingsId         String       @unique
  cloudName          String
  apiKey             String
  encryptedApiSecret String
  uploadPreset       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  SiteSettings       SiteSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
}

model EmailBranding {
  id           String       @id @default(cuid())
  settingsId   String       @unique
  logoUrl      String?
  primaryColor String       @default("#556B2F")
  accentColor  String       @default("#E87A1E")
  footerText   String       @default("Daily Nutrition, Nairobi, Kenya")
  websiteUrl   String       @default("https://dailynutrition.com")
  supportEmail String       @default("support@dailynutrition.com")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  SiteSettings SiteSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
}

model GoogleCalendarConfig {
  id                   String       @id @default(cuid())
  settingsId           String       @unique
  eventDuration        Int          @default(30)
  bufferTime           Int          @default(15)
  minNotice            Int          @default(120)
  availability         Json         @default("{}")
  encryptedClientEmail String?
  encryptedPrivateKey  String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  SiteSettings         SiteSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
}

model ResendConfig {
  id              String       @id @default(cuid())
  settingsId      String       @unique
  encryptedApiKey String?
  fromEmail       String       @default("onboarding@resend.dev")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  SiteSettings    SiteSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
}

model NotificationPreferences {
  id                      String       @id @default("default")
  settingsId              String       @unique
  emailOnNewBooking       Boolean      @default(true)
  emailOnCancellation     Boolean      @default(true)
  emailOnReschedule       Boolean      @default(true)
  emailOnPaymentSubmitted Boolean      @default(true)
  emailDailyAgenda        Boolean      @default(false)
  agendaTime              String       @default("08:00")
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  SiteSettings            SiteSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
}

model SiteSettings {
  id                      String                   @id @default("default")
  businessName            String                   @default("Daily Nutrition")
  contactEmail            String                   @default("info@dailynutrition.com")
  phoneNumber             String                   @default("+254 700 000 000")
  address                 String                   @default("Nairobi, Kenya")
  latitude                Float                    @default(-1.2921)
  longitude               Float                    @default(36.8219)
  googleMapsEmbedUrl      String                   @default("")
  pageTitle               String                   @default("Daily Nutrition | Professional Nutrition Consultancy")
  metaDescription         String                   @default("Expert nutrition advice.")
  keywords                String                   @default("nutrition, health, diet")
  paymentTillNumber       String                   @default("")
  paymentPaybill          String                   @default("")
  paymentAccountNumber    String                   @default("")
  paymentAccountName      String                   @default("")
  ogImageUrl              String?                  @default("")
  version                 Int                      @default(0)
  updatedAt               DateTime                 @updatedAt
  profileImageUrl         String?                  @default("")
  aboutImageOne           String                   @default("")
  aboutImageTwo           String                   @default("")
  themePreference         String                   @default("light")
  googleCalendarId        String                   @default("")
  CloudinaryConfig        CloudinaryConfig?
  EmailBranding           EmailBranding?
  GoogleCalendarConfig    GoogleCalendarConfig?
  ResendConfig            ResendConfig?
  NotificationPreferences NotificationPreferences?

  instagramUrl String @default("")
  linkedinUrl  String @default("")
  twitterUrl   String @default("")
  facebookUrl  String @default("")

  /// Master switch for the M-Pesa STK Push checkout. While false the legacy
  /// manual Paybill + transaction-code flow runs untouched, so the new rail can
  /// be deployed dark and enabled only after a live low-value test passes.
  mpesaStkEnabled Boolean @default(false)

  privacyPolicyContent String @default("")
  termsContent         String @default("")
  cookiePolicyContent  String @default("")
  googlePlaceId        String @default("")
}

model EmailLog {
  id             String    @id @default(cuid())
  recipientEmail String
  subject        String
  status         String    @default("PENDING") // PENDING, SENT, FAILED
  errorMessage   String?
  context        String // e.g. "BOOKING_CANCELLATION", "INQUIRY_REPLY", "BOOKING_CONFIRMATION"
  entityId       String? // referenceCode or inquiryId
  retryCount     Int       @default(0)
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([status])
  @@index([context])
  @@index([recipientEmail])
  @@index([createdAt])
}

/// Durable sliding-window rate limiting.
/// Serverless instances do not share memory, so the in-memory limiter alone is
/// per-instance and trivially bypassed by hitting a different lambda. Each row is
/// one request hit; the window is evaluated by counting rows newer than the cutoff.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
//  Payments — M-Pesa STK Push (Daraja)
// ────────────────────────────────────────────────────────────────────────────

enum PaymentStatus {
  INITIATED /// Row written, Daraja not yet called. Exists BEFORE the push so an
  /// early callback can never arrive for a payment we have not persisted.
  PENDING /// Push accepted by Safaricom, awaiting the customer's PIN.
  SUCCESS /// Confirmed and reconciled. Fulfilment has fired exactly once.
  FAILED /// Declined — wrong PIN, insufficient funds, unreachable handset.
  CANCELLED /// Customer dismissed the prompt (result code 1032).
  TIMEOUT /// No callback and the query stayed inconclusive past the window.
  MISMATCH /// Money arrived but the amount ≠ expected. Quarantined: never auto-fulfils.
}

enum PaymentPurpose {
  BOOKING
  MEAL_PLAN_ORDER
}

/// The single ledger for every shilling the platform collects.
///
/// One table serves bookings and meal-plan orders alike so that exactly one code
/// path — reconcile() — may transition a row to SUCCESS, and so revenue reporting
/// has one authoritative source rather than several partial ones.
model Payment {
  id        String         @id @default(cuid())
  reference String         @unique /// Internal, human-quotable ("PAY-XXXXXX").
  purpose   PaymentPurpose

  /// Exactly one of these is set, enforced in application code because Prisma
  /// cannot express an XOR constraint.
  bookingId       String?
  booking         Booking?       @relation(fields: [bookingId], references: [id])
  mealPlanOrderId String?
  mealPlanOrder   MealPlanOrder? @relation(fields: [mealPlanOrderId], references: [id])

  amountExpected Int /// Whole shillings — M-Pesa has no minor unit.
  amountPaid     Int?
  phoneNumber    String /// Normalised to 2547…/2541… before it is ever stored.

  status   PaymentStatus @default(INITIATED)
  provider String        @default("MPESA_STK") /// MPESA_STK | MPESA_MANUAL

  merchantRequestId  String?
  /// Daraja's idempotency key. Unique so a retried callback cannot create a
  /// second payment, and so the guarded updateMany has a single target row.
  checkoutRequestId  String? @unique
  /// Unique platform-wide: the same M-Pesa receipt can never be attached to two
  /// orders, not even through the admin reconciliation override.
  mpesaReceiptNumber String? @unique

  resultCode String?
  resultDesc String?
  attempt    Int     @default(1)

  initiatedAt DateTime  @default(now())
  completedAt DateTime?
  expiresAt   DateTime?

  failureReason String?
  initiatedIp   String?
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  callbacks MpesaCallbackLog[]

  @@index([status, initiatedAt])
  @@index([bookingId])
  @@index([mealPlanOrderId])
  @@index([phoneNumber])
}

/// Verbatim capture of every callback Safaricom delivers.
///
/// Written BEFORE any processing is attempted, which is what makes the
/// callback-arrives-before-our-own-write race survivable: an unmatched callback
/// is still durably recorded and is replayed later by the reconciliation cron.
model MpesaCallbackLog {
  id String @id @default(cuid())

  checkoutRequestId String?
  merchantRequestId String?
  resultCode        String?

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  payload  Json /// The raw body, exactly as received.
  sourceIp String?

  processed       Boolean @default(false)
  processingError String? @db.Text

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([checkoutRequestId])
  @@index([processed, receivedAt])
  @@index([paymentId])
}

// ────────────────────────────────────────────────────────────────────────────
//  Meal plans — owner-controlled commercial settings
// ────────────────────────────────────────────────────────────────────────────

/// Singleton (id = "default") holding every number the owner must be able to
/// change without a deploy: weekly capacity for bespoke plans, the fulfilment
/// SLA, the revision policy, and even the public tier names — so marketing can
/// rename a tier without a migration.
model MealPlanSettings {
  id String @id @default("default")

  /// Bespoke plans sold per ISO week, evaluated in Africa/Nairobi. A personalised
  /// plan is 60–120 minutes of clinical time; selling thirty in a week produces
  /// missed SLAs and refunds, which costs more than the foregone sale.
  personalizedCapacityPerWeek Int     @default(5)
  /// Hard pause, for holidays or overload. Withdraws the tier from sale at once.
  acceptingPersonalized       Boolean @default(true)
  waitlistEnabled             Boolean @default(true)

  fulfilmentSlaHours Int @default(72)
  freeRevisions      Int @default(1)
  revisionWindowDays Int @default(14)

  /// Public tier labels. "Template" does not sell in this market, and the naming
  /// is a marketing decision that must not require a code change.
  signatureTierLabel    String @default("Signature Plans")
  personalizedTierLabel String @default("Personal Plans")

  /// Gates the public /meal-plans route and its nav link. Kept false until at
  /// least one plan is published, so the header never leads to an empty grid.
  storefrontEnabled Boolean @default(false)

  version   Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ────────────────────────────────────────────────────────────────────────────
//  Meal plans
// ────────────────────────────────────────────────────────────────────────────

enum MealPlanTier {
  /// Self-serve, built from real patient cases. Sold to buyers we have not assessed,
  /// which is why the clinical screener is load-bearing rather than decorative.
  SIGNATURE
  /// Bespoke, built around one client's labs, kitchen and budget. Capacity-limited.
  PERSONALIZED
}

enum MealPlanOrderStatus {
  PENDING_PAYMENT
  PAID
  INTAKE_REQUIRED /// Personalised only: awaiting the clinical questionnaire.
  IN_PREPARATION /// Intake received, SLA clock running.
  DELIVERED
  REVISION_REQUESTED
  CANCELLED
  EXPIRED /// Never paid for within the window.
  REFUNDED
}

/// A sellable plan on the storefront. Entirely owner-authored — nothing about the
/// catalogue is hardcoded, so plans are added, repriced and withdrawn without a deploy.
model MealPlan {
  id       String  @id @default(cuid())
  slug     String  @unique
  title    String
  subtitle String?

  tier MealPlanTier @default(SIGNATURE)

  shortDescription String
  fullDescription  String?  @db.Text
  features         String[]

  /// Whole shillings, matching Service. compareAtPrice is the struck-through anchor.
  price          Int
  compareAtPrice Int?
  durationDays   Int?

  coverImage      String?
  sampleImageUrls String[]

  /// Which consultation a screened-out buyer is routed to. The block is only
  /// commercially sensible because it converts into a higher-value lead.
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  /// Screening keys that BLOCK purchase. A controlled vocabulary from
  /// lib/meal-plans/screening.ts — free text here would silently disable the gate,
  /// because the admin's wording would never match the screener's keys.
  contraindications String[]

  /// Null inherits the global weekly capacity from MealPlanSettings.
  capacityOverride Int?

  metaTitle       String?
  metaDescription String?

  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0)
  version      Int           @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  orders MealPlanOrder[]
  assets MealPlanAsset[]

  @@index([slug])
  @@index([status])
  @@index([tier])
  @@index([displayOrder])
}

/// One purchase. Snapshots title and price so a renamed, repriced or withdrawn plan
/// still renders correctly in the buyer's order history and in revenue reporting.
model MealPlanOrder {
  id            String @id @default(cuid())
  referenceCode String @unique /// "MP-XXXXXX"

  mealPlanId String?
  mealPlan   MealPlan?    @relation(fields: [mealPlanId], references: [id])
  tier       MealPlanTier

  /// Immutable snapshots. Never read the live plan for a historical order.
  planTitleSnapshot String
  pricePaid         Int

  clientName  String
  clientEmail String
  clientPhone String?

  status MealPlanOrderStatus @default(PENDING_PAYMENT)

  /// Set when the plan was bought as an add-on during a consultation booking.
  linkedBookingId String?
  linkedBooking   Booking? @relation(fields: [linkedBookingId], references: [id])

  paidAt      DateTime?
  dueAt       DateTime? /// Fulfilment SLA deadline.
  deliveredAt DateTime?
  expiresAt   DateTime? /// Payment window for an unpaid order.

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  /// Evidence the buyer accepted the educational-guidance disclaimer.
  disclaimerAcceptedAt DateTime?

  revisionCount       Int       @default(0)
  revisionNotes       String?   @db.Text
  revisionRequestedAt DateTime?

  /// Cron idempotency flags, mirroring the booking reminder pattern.
  intakeNudge24hSent Boolean @default(false)
  intakeNudge72hSent Boolean @default(false)
  slaWarningSent     Boolean @default(false)
  slaBreachAlerted   Boolean @default(false)
  followUpSent       Boolean @default(false)
  upsellSent         Boolean @default(false)

  internalNotes String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  payments       Payment[]
  intake         MealPlanIntake?
  assets         MealPlanAsset[]
  downloadTokens MealPlanDownloadToken[]

  @@index([status])
  @@index([clientEmail])
  @@index([dueAt])
  @@index([mealPlanId])
  @@index([paidAt])
}

/// The clinical questionnaire — the most sensitive data on the platform.
///
/// A booking holds a name and a time. An intake holds diagnoses, medications, weight
/// and pregnancy status, so the payload is encrypted at rest with the same AES-256-GCM
/// helper used for Meet links. Only non-identifying screeningFlags stay in plaintext,
/// so "how many orders were flagged" is answerable without decrypting anything.
model MealPlanIntake {
  id      String        @id @default(cuid())
  orderId String        @unique
  order   MealPlanOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  encryptedPayload String   @db.Text
  screeningFlags   String[]

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// A deliverable file. Stores a storage KEY, never a URL — the moment a public
/// res.cloudinary.com URL for a paid PDF is persisted, the product is one WhatsApp
/// forward from worthless.
model MealPlanAsset {
  id String @id @default(cuid())

  /// Attached either to a plan (the Signature deliverable) or to one order (a
  /// personalised plan prepared for a single buyer).
  mealPlanId String?
  mealPlan   MealPlan?      @relation(fields: [mealPlanId], references: [id])
  orderId    String?
  order      MealPlanOrder? @relation(fields: [orderId], references: [id])

  storageKey String /// Private Cloudinary public_id.
  filename   String
  mimeType   String @default("application/pdf")
  size       Int    @default(0)
  version    Int    @default(1)

  /// Per-buyer watermarking makes sharing socially awkward, which is where
  /// deterrence for digital goods actually lives.
  watermarked Boolean @default(false)

  createdAt DateTime @default(now())

  downloadTokens MealPlanDownloadToken[]

  @@index([mealPlanId])
  @@index([orderId])
}

/// Expiring, counted, revocable download grant.
///
/// Binds to the ASSET rather than the plan, so archiving or unpublishing a plan can
/// never break a link a buyer has already paid for.
model MealPlanDownloadToken {
  id    String @id @default(cuid())
  token String @unique

  orderId String
  order   MealPlanOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assetId String
  asset   MealPlanAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  expiresAt      DateTime
  maxDownloads   Int       @default(5)
  downloadCount  Int       @default(0)
  lastDownloadIp String?
  lastDownloadAt DateTime?
  revokedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([expiresAt])
}

/// Waitlist for when bespoke capacity is exhausted. Capturing the lead is worth more
/// than the refused sale, and it tells the owner exactly how much to raise capacity by.
model MealPlanWaitlistEntry {
  id String @id @default(cuid())

  mealPlanId String?
  name       String
  email      String
  phone      String?

  notifiedAt  DateTime?
  convertedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([mealPlanId])
  @@index([email])
}

// ────────────────────────────────────────────────────────────────────────────
//  Insurance Providers — clinic-partnership billing model
// ────────────────────────────────────────────────────────────────────────────

/// Each row represents one accepted insurance company.
/// Clients visiting the partner clinic pay their insurer directly; the clinic
/// then settles with the platform owner on a monthly basis.
/// Admin can add, edit, toggle active/inactive, reorder, and permanently delete.
model InsuranceProvider {
  id          String  @id @default(cuid())
  name        String  /// e.g. "Cigna", "CIC Insurance Group"
  logoUrl     String? /// Optional logo stored in media library
  description String? /// e.g. "Covers outpatient nutrition consultations"
  contactInfo String? /// e.g. "Call 0703 099 120 or visit cicinsurancegroup.com"
  websiteUrl  String? /// Link to insurer's public website

  /// Soft-toggle without permanent deletion — useful when a partnership is
  /// temporarily suspended rather than fully terminated.
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([displayOrder])
}
